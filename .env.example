# KrishiNova Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, tokens, or private keys to source control.

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=KrishiNova
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS Cloud Infrastructure Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock / Nova Configuration
# Supported models: amazon.nova-lite-v1:0 (Fast text advisory), amazon.nova-pro-v1:0 (Multimodal Vision)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL_ID=amazon.nova-pro-v1:0

# Amazon DynamoDB Configuration
DYNAMODB_TABLE_NAME=KrishiNovaTable-dev

# Amazon S3 Object Storage (Crop Diagnostic Uploads)
S3_ASSETS_BUCKET=krishinova-crop-assets-dev

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

# External Agricultural APIs (Optional overrides)
# Weather uses WeatherAPI.com (or Open-Meteo free global meteorological feed as fallback)
WEATHER_API_KEY=
# Google Gemini 2.5 Flash / Bedrock Multimodal Vision & Advisory
GEMINI_API_KEY=
# Indian agricultural market data (data.gov.in / Agmarknet API key if configured)
DATA_GOV_IN_API_KEY=

# Session Encryption Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET=development_temporary_secret_key_change_in_production
